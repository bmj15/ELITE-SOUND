# Copie este ficheiro para ".env" e ajuste os valores.

# Porta do servidor (o site abre em http://localhost:5000)
PORT=5000

# Chave secreta dos logins. Troque por um texto longo e aleatório.
JWT_SECRET=troque-isto-por-um-texto-longo-e-aleatorio

# Primeiro administrador (criado só se ainda não existir nenhum admin)
ADMIN_EMAIL=admin@elitesound.local
ADMIN_PASSWORD=admin123

# Base de dados: por defeito SQLite (ficheiro em backend/data, não precisa de instalar nada).
# Para usar MySQL, descomente e preencha:
# DB_DIALECT=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=elitesound_db
# DB_USER=root
# DB_PASSWORD=root
